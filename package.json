{
  "name": "bjj-event-scraper",
  "version": "1.0.0",
  "description": "Scraper de competições de jiu-jitsu (calendários de federações como IBJJF e CBJJ, e a plataforma de inscrição Smoothcomp) → events.json para o app BJJ Avatar",
  "type": "module",
  "private": true,
  "scripts": {
    "scrape": "tsx src/index.ts",
    "validate": "tsx src/validate.ts",
    "discover": "tsx scripts/discover.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
